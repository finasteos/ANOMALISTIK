# ANOMALISTICS — environment template
# Copy to .env (never commit .env). See TASKLIST.md T4/B2/D6.

# AI (server.ts callOpenRouter → OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free
# Optional referer shown to OpenRouter
APP_PUBLIC_URL=https://anomalistics.local

# Geospace pipelines (scripts/fetch_geospace_sync.py)
MAST_API_TOKEN=
ESA_EO_USERNAME=
ESA_EO_PASSWORD=

# Server
PORT=3000
NODE_ENV=development
# Comma-separated extra origins for CORS (same-origin by default)
CORS_ALLOWLIST=
